# LOCAL development only — copy this file to .env.
# For Vercel deployment, set these in: Vercel Dashboard → your project → Settings → Environment Variables (Production = true), then redeploy.

PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.hqfehez.mongodb.net/?appName=Cluster0
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Set to "false" to skip seeding 14 days of demo history for new accounts
SEED_DEMO_DATA=true